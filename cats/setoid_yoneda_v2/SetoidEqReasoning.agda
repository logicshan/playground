open import Level using (Level)
open import Setoids

module SetoidEqReasoning {c ℓ : Level} (S : Setoid c ℓ) where

open Setoid S

infixl 3 _∼_by_
infixl 3 _∼_yb_
infix  4 ∵_

-- ============================================================================
-- 等式推导起点
-- ============================================================================
∵_ : (x : Carrier) → x ∼ x
∵_ x = refl∼

-- ============================================================================
-- 链式传递 (正向)
-- x ∼ y, 引入 z 并证明 y ∼ z, 最终得到 x ∼ z
-- ============================================================================
_∼_by_ : ∀ {x y : Carrier} → x ∼ y → (z : Carrier) → y ∼ z → x ∼ z
_∼_by_ x∼y _ y∼z = trans∼ y∼z x∼y

-- ============================================================================
-- 链式传递 (反向 / 运用对称律)
-- x ∼ y, 引入 z 并证明 z ∼ y (利用 sym 翻转为 y ∼ z), 最终得到 x ∼ z
-- ============================================================================
_∼_yb_ : ∀ {x y : Carrier} → x ∼ y → (z : Carrier) → z ∼ y → x ∼ z
_∼_yb_ x∼y _ z∼y = trans∼ (sym∼ z∼y) x∼y
